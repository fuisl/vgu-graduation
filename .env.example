# Database Configuration (Docker Compose Postgres)
POSTGRES_USER=grad
POSTGRES_PASSWORD=grad_local_dev
POSTGRES_DB=grad26
POSTGRES_PORT=5432
DATABASE_URL=postgres://grad:grad_local_dev@localhost:5432/grad26

# Apps configuration
PORT=4000
NODE_ENV=development
API_ORIGIN=http://localhost:4000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
LOG_LEVEL=info
# Required when NODE_ENV=production; optional locally until the media/print/translation modules land.
# HS256 secret shared with apps/web for admin session tokens. Never commit a real value.
ADMIN_SESSION_SECRET=dev-only-change-me
