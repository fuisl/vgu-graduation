{
  "name": "@grad/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "lint": "echo 'api: lint ok'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/lib-storage": "^3.1143.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/websocket": "^11.3.1",
    "@grad/contract": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
