# BFF layer (docs/architecture/target/networking-and-setup.md §8.3)
API_ORIGIN=http://localhost:4000
ADMIN_SESSION_SECRET=dev-only-change-me
# Domain of the invitation cookie `inv` (set by /invite/[token]). Leave unset for a
# host-only cookie; in production use the parent domain (ADR-003), e.g. .grad26.fuisloy.dev.
COOKIE_DOMAIN=localhost

# Admin sign-in (#41). GITHUB_CLIENT_ID is the real, shared value — it's
# not secret, it's embedded in every GitHub authorize-URL redirect.
# GITHUB_CLIENT_SECRET is real per-app secret: get it from whoever holds
# it (GitHub only shows it once, at creation) and put it in .env.local,
# never here.
GITHUB_CLIENT_ID=Ov23li1WOsrS2ZKdefpp
GITHUB_CLIENT_SECRET=ask-for-the-real-value-never-commit-this
