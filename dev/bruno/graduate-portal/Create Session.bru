meta {
  name: Create Session
  type: http
  seq: 2
}

post {
  url: {{apiOrigin}}/graduate/sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{graduateSignInToken}}"
  }
}

docs {
  Spends the sign-in token (once, within 30 minutes; 401 otherwise).
  Copy the response's `token` into the `graduateSessionToken` secret
  var. Never paste a token into a non-secret var (ADR-017).
}
