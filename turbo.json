{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DOCS_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@grad/web#build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DOCS_ORIGIN"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@grad/docs#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "@grad/api#test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "env": [
        "DATABASE_URL"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "outputs": []
    }
  }
}
